LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT

#define LANG     0x0419  // Locale: Russian (RU)
#define CHARSET  0x04E3  // Code Page: 1251

                         //"Свободный софт"
#define CompanyName      0x0421,0x0432,0x043E,0x0431,0x043E,0x0434,0x043D,0x044B,0x0439,0x0020,0x0441 \
                         0x043E,0x0444,0x0442,0x00


                         //"Прокси-библиотека для браузеров Brave, Chrome, Opera, Vivaldi, Yandex и др."
#define FileDescription  0x041F,0x0440,0x043E,0x043A,0x0441,0x0438,0x002D,0x0431,0x0438,0x0431,0x043B \
	                       0x0438,0x043E,0x0442,0x0435,0x043A,0x0430,0x0020,0x0434,0x043B,0x044F,0x0020 \
	                       0x0431,0x0440,0x0430,0x0443,0x0437,0x0435,0x0440,0x043E,0x0432,0x0020,0x0042 \
	                       0x0072,0x0061,0x0076,0x0065,0x002C,0x0020,0x0043,0x0068,0x0072,0x006F,0x006D \
	                       0x0065,0x002C,0x0020,0x004F,0x0070,0x0065,0x0072,0x0061,0x002C,0x0020,0x0056 \
	                       0x0069,0x0076,0x0061,0x006C,0x0064,0x0069,0x002C,0x0020,0x0059,0x0061,0x006E \
	                       0x0064,0x0065,0x0078,0x0020,0x0438,0x0020,0x0434,0x0440,0x002E,0x00

                         //"Прокси-библиотека"
#define InternalName	   0x041F,0x0440,0x043E,0x043A,0x0441,0x0438,0x002D,0x0431,0x0438,0x0431,0x043B \
	                       0x0438,0x043E,0x0442,0x0435,0x043A,0x0430,0x00

                         //"Российская Федерация"
#define LegalCopyright	 0x0420,0x043E,0x0441,0x0441,0x0438,0x0439,0x0441,0x043A 0x0430,0x044F,0x0020 \
	                       0x0424,0x0435,0x0434,0x0435,0x0440,0x0430,0x0446,0x0438,0x044F,0x00

                         //"Свободный софт"
#define LegalTrademarks  0x0421,0x0432,0x043E,0x0431,0x043E,0x0434,0x043D,0x044B,0x0439,0x0020,0x0441 \
                         0x043E,0x0444,0x0442,0x00

                         //"Прокси-библиотека"
#define ProductName      0x041F,0x0440,0x043E,0x043A,0x0441,0x0438,0x002D,0x0431,0x0438,0x0431,0x043B \
	                       0x0438,0x043E,0x0442,0x0435,0x043A,0x0430,0x00

#define OriginalFilename "version.dll\0"
#define ProductVersion   "1.0.6.1\0"
#define FileVersion      "1.0.6.1\0"

// Version info
#define MAJOR       1
#define MINOR       0
#define RELEASE     6
#define BUILD       1

1 VERSIONINFO
FILEVERSION MAJOR, MINOR, RELEASE, BUILD
PRODUCTVERSION MAJOR, MINOR, RELEASE, BUILD
FILEOS 0x4
FILETYPE 0x2

BEGIN

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0419, 0x04E3
  END

  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904E3"
    BEGIN
      VALUE "CompanyName", CompanyName
      VALUE "FileDescription", FileDescription
      VALUE "FileVersion", FileVersion
      VALUE "InternalName", InternalName
      VALUE "LegalCopyright", LegalCopyright
      VALUE "LegalTrademarks", LegalTrademarks
      VALUE "OriginalFilename", OriginalFilename
      VALUE "ProductName", ProductName
      VALUE "ProductVersion", ProductVersion
    END
  END
END
